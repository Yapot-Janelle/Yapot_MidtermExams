<Window x:Class="Yapot_MidtermExam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Yapot_MidtermExam"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBlock 
            Text="Shopping Cart System"
            Height="28"
            HorizontalAlignment="Center"
            Margin="0,22,0,0"
            VerticalAlignment="Top"
            FontSize="20"
            FontWeight="Bold"
            TextAlignment="Center">
        </TextBlock>
        <TextBlock 
            Text="Available Items"
            Height="28"
            HorizontalAlignment="Left"
            Margin="142,77,0,0"
            VerticalAlignment="Top"
            FontSize="20"
            FontWeight="Bold"
            TextAlignment="Center"/>
        <TextBlock 
            Text="Shopping Cart"
            Height="28"
            HorizontalAlignment="Left"
            Margin="518,77,0,0"
            VerticalAlignment="Top"
            FontSize="20"
            FontWeight="Bold"
            TextAlignment="Center"/>
        <DataGrid
            Name ="AvailableItemGrid"
            Margin="28,110,400,0"
            Height="160"
            VerticalAlignment="Top"
            ItemsSource="{Binding AvailableItems}"
            AutoGenerateColumns="False">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="*"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="*"/>
            </DataGrid.Columns>


        </DataGrid>
        <DataGrid
            x:Name ="ShoppingCartGrid"
            Margin="400,110,28,0"
            Height="160"
            VerticalAlignment="Top"
            ItemsSource="{Binding ShoppingCart}"
            AutoGenerateColumns="False">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="*"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="*"/>
            </DataGrid.Columns>

        </DataGrid>

        <TextBox Name="IdTextBox"
            HorizontalAlignment="Left" 
            Height="30" Margin="169,320,0,0" 
            TextWrapping="Wrap" 
            VerticalAlignment="Top" Width="45" 
        />

        <TextBox x:Name="NameTextBox"
        HorizontalAlignment="Left" 
        Height="30" Margin="241,320,0,0" 
        TextWrapping="Wrap" 
        VerticalAlignment="Top" Width="90" 
        />

        <TextBox x:Name="DescriptionTextBox"
        HorizontalAlignment="Left" 
        Height="30" Margin="353,320,0,0" 
        TextWrapping="Wrap" 
        VerticalAlignment="Top" Width="140" 
        />

        <TextBox x:Name="PriceTextBox"
        HorizontalAlignment="Left" 
        Height="30" Margin="518,320,0,0" 
        TextWrapping="Wrap" 
        VerticalAlignment="Top" Width="90" 
        />

        <TextBlock HorizontalAlignment="Left" Margin="169,299,0,0" TextWrapping="Wrap" Text="ID" VerticalAlignment="Top"/>
        <TextBlock HorizontalAlignment="Left" Margin="241,299,0,0" TextWrapping="Wrap" Text="Name" VerticalAlignment="Top" RenderTransformOrigin="-0.473,0.551"/>
        <TextBlock HorizontalAlignment="Left" Margin="353,299,0,0" TextWrapping="Wrap" Text="Description" VerticalAlignment="Top"/>
        <TextBlock HorizontalAlignment="Left" Margin="518,299,0,0" TextWrapping="Wrap" Text="Price" VerticalAlignment="Top" RenderTransformOrigin="3.535,-0.64"/>

        <Button Content="Clear" HorizontalAlignment="Left" Height="30" Margin="229,372,0,0" VerticalAlignment="Top" Width="82" Click="Clear_Click"/>
        <Button Content="Add Item" HorizontalAlignment="Left" Height="30" Margin="316,372,0,0" VerticalAlignment="Top" Width="82" Click="AddItem_Click"/>
        <Button Content="Remove Item" HorizontalAlignment="Left" Height="30" Margin="403,372,0,0" VerticalAlignment="Top" Width="82" Click="RemoveItem_Click"/>
        <Button Content="Add to Cart" HorizontalAlignment="Left" Height="30" Margin="490,372,0,0" VerticalAlignment="Top" Width="82" Click="AddToCart_Click"/>

    </Grid>
</Window>
